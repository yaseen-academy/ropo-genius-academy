# Copy this file to .env.local and fill in the real values.

# From Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string, used to sign teacher/student session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Used by the in-site AI assistant (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=your-anthropic-api-key

# WhatsApp contact number used by the "Chat on WhatsApp" buttons (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=201116675681

# Vodafone Cash number shown on the pricing/course cards
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=01116675681
